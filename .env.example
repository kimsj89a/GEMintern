# GEM Intern — 환경변수 예시
# 실제 사용 시 .env 로 복사하고 값만 채워서 사용. .env 는 git에 commit 금지.

# ── LLM API Keys ──
# Gemini (기본 LLM, 모든 분석/생성 기능)
GEMINI_API_KEY=

# Anthropic (claude- 로 시작하는 모델 지정 시 사용; 없으면 Gemini fallback)
ANTHROPIC_API_KEY=

# OpenAI (RAG-Anything 한정 — gpt-5.4 + text-embedding-3-large)
OPENAI_API_KEY=

# ── RAG-Anything feature flag ──
# false (기본): 기존 RAG 스택(core_rag_vector/bm25/hybrid) 사용
# true: 신규 LightRAG + MinerU 파이프라인 사용 (Phase 2+에서 활성화)
USE_RAG_ANYTHING=false

# ── McKinsey PPT builder feature flag ──
# false (기본): per-request use_mckinsey 플래그로만 활성
# true: /create-pptx, /create-ib-pptx 가 항상 vendored mckinsey 빌더 우선 시도
USE_MCKINSEY_PPTX=false

# ── 서버 ──
HOST=0.0.0.0
PORT=8741

# ── 저장소 (선택, 기본은 ./rag_storage) ──
# RAG_STORAGE_DIR=
